default_platform(:ios)

platform :ios do
  desc "App Store Connect API Keyの設定（CI環境用）"
  private_lane :setup_api_key do
    if ENV["APP_STORE_CONNECT_API_KEY_ID"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"),
        in_house: false
      )
    end
  end

  desc "ビルドしてApp Store Connectにアップロード"
  lane :release do
    setup_api_key
    build_app(
      scheme: "OracleDiary",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.oraclediary.app" => "OracleDiary AppStore"
        }
      },
      clean: true,
      output_directory: "./build",
      output_name: "OracleDiary.ipa"
    )

    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "ビルドしてTestFlightにアップロード"
  lane :beta do
    setup_api_key
    increment_build_number(
      xcodeproj: "OracleDiary.xcodeproj"
    )
    build_app(
      scheme: "OracleDiary",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.oraclediary.app" => "OracleDiary AppStore"
        }
      },
      clean: true,
      output_directory: "./build",
      output_name: "OracleDiary.ipa"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "ビルドのみ（アップロードなし）"
  lane :build_only do
    build_app(
      scheme: "OracleDiary",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "OracleDiary.ipa"
    )
  end
end
